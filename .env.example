DOMAIN=localhost
# Public origin used in therapist invite links (defaults to https://$DOMAIN).
PUBLIC_BASE_URL=http://localhost:8081
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
POSTGRES_DB=counselling
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/counselling
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test-user
SMTP_PASS=test-pass
SMTP_FROM=noreply@localhost
EMBEDDING_MODEL=intfloat/multilingual-e5-small
FASTEMBED_CACHE_PATH=/opt/fastembed
KB_DIR=kb
KB_MIN_SIMILARITY=0.826
DEMO_MODE=1
# FAKE_LLM=1 returns canned model output (demos/e2e only). It must stay 0 in production.
FAKE_LLM=0
# Required for live model calls; leave empty for FAKE_LLM or tests. Never commit a real key.
ANTHROPIC_API_KEY=
# Scheduler (reminders and the overnight monitor); 0 disables it.
SCHEDULER_ENABLED=0
OVERNIGHT_HOUR_UTC=21
REMINDER_HOUR_UTC=4
# Set to 1 only behind a trusted reverse proxy (Caddy) so client IPs come from X-Forwarded-For.
TRUST_PROXY=0
UPLOAD_DIR=/data/uploads
# Idea-to-launch (practice owners). Pages are always served by Saarthi at /p/{slug}; a custom domain is optional.
# GoDaddy keys are optional: without them (or if GoDaddy denies access) domain ideas get a "Check and register on GoDaddy" link.
# The app never buys a domain, and writes DNS only when GODADDY_ALLOW_DNS_WRITE=1.
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_API_BASE=https://api.godaddy.com
GODADDY_ALLOW_DNS_WRITE=0
# The server's public IP address. Custom domains get an A record for @ pointing here. Empty = no DNS records are planned.
SAARTHI_SERVER_IP=
# USD per million tokens. Set BOTH to show an estimated cost to owners; leave empty to show tokens only.
LAUNCH_PRICE_IN_PER_MTOK=
LAUNCH_PRICE_OUT_PER_MTOK=
